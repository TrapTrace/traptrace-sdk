  "keywords": [
    "stellar",
    "soroban",
    "smart-contracts",
    "wasm",
    "error-decoder",
    "diagnostics",
    "traptrace"
  ],
  "dependencies": {
    "@stellar/stellar-sdk": "16.0.1"
  },
  "engines": {
    "node": ">=22"
  },
  "author": "OTimileyin <timileyin@users.noreply.github.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/TrapTrace/traptrace-sdk.git"
  },
  "files": [
    "src",
    "index.d.ts",
    "docs"
  ]
